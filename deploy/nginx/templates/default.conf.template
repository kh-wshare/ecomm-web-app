# Rendered by the nginx image's entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf on container start. Only variables that are
# actually exported in the container environment get substituted, so nginx's
# own $host/$request_uri/etc. runtime variables are left untouched.

# Plain HTTP: serve ACME challenges for cert issuance/renewal, redirect
# everything else to HTTPS.
server {
    listen 80;
    server_name ${GATEWAY_DOMAIN} ${MARKETING_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Gateway: storefront at "/", merchant at "/merchant".
server {
    listen 443 ssl;
    http2 on;
    server_name ${GATEWAY_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${GATEWAY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${GATEWAY_DOMAIN}/privkey.pem;

    client_max_body_size 20m;

    location /merchant/_next/static/ {
        proxy_pass http://merchant:3008;
        proxy_set_header Host $host;
    }

    location /merchant {
        proxy_pass http://merchant:3008;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /_next/static/ {
        proxy_pass http://storefront:3002;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://storefront:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Marketing: standalone public site, its own vhost (not part of the gateway
# routing table above).
server {
    listen 443 ssl;
    http2 on;
    server_name ${MARKETING_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${MARKETING_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MARKETING_DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://marketing:3003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
