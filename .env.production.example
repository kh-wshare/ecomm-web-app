# Copy to .env.production on the production host (same directory as
# docker-compose.prod.yml) and fill in real values. This file is consumed by:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# Never commit the real .env.production file.

# --- Image source ---
# The deploy workflow exports a per-app tag (commit SHA) only for the app(s)
# it actually rebuilt, so deploying one app never moves the others. Leave
# these at "latest" for a manual `docker compose up --build`.
REGISTRY_IMAGE=ghcr.io/kh-wshare/ecomm-web-app
MARKETING_IMAGE_TAG=latest
MERCHANT_IMAGE_TAG=latest
STOREFRONT_IMAGE_TAG=latest
    
# --- Gateway ---
GATEWAY_PORT=80
GATEWAY_TLS_PORT=443
# Domain serving storefront ("/"), merchant ("/merchant")
GATEWAY_DOMAIN=shop.example.com
# Domain serving the standalone marketing site
MARKETING_DOMAIN=www.example.com
# Email Let's Encrypt uses for expiry/urgent notices
LETSENCRYPT_EMAIL=ops@example.com
# Set to 1 to issue against Let's Encrypt's staging environment (higher rate
# limits, untrusted cert) while testing deploy/nginx/init-letsencrypt.sh
LETSENCRYPT_STAGING=0

# --- Backend API ---
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WEBSOCKET_URL=https://api.example.com

# --- Public app URLs ---
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_STOREFRONT_URL=https://shop.example.com
NEXT_PUBLIC_DASHBOARD_URL=https://shop.example.com/merchant

# --- Firebase (merchant + storefront) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# --- Telegram login (merchant + storefront) ---
NEXT_PUBLIC_TELEGRAM_CLIENT_ID=
NEXT_PUBLIC_TELEGRAM_REDIRECT_URI=
